#!/usr/bin/env bash
# SubagentStart hook: tell subagents to use codebase-memory-mcp tools.
# SubagentStart injects context via JSON additionalContext, not plain stdout.
# Heredoc-free (see cbm-session-reminder): upstream's version sits just under
# the 512-byte pipe deadlock line — one content edit away from freezing
# every subagent spawn.
printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SubagentStart","additionalContext":"Code discovery: when your task names a code_graph project, use codebase-memory-mcp tools (search_graph, trace_path, get_code_snippet) with that project to find callers and usages before grepping. Grep/Read stay the proof you cite."}}'
